<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dashboard · Equipment Borrowing</title>
<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:2rem auto;padding:0 1rem}
table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #ddd;padding:.45rem;text-align:left}
nav{display:flex;gap:1rem;align-items:center;margin-bottom:1rem}nav form{margin-left:auto}</style><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav>
  <strong>Equipment Borrowing</strong>
  <% if (user.role === 'admin' || user.role === 'custodian') { %><a href="/inventory">Manage inventory</a><% } %>
  <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%= user.username %> (<%= user.role %>) <button>Log out</button></form>
</nav>
<h1>Dashboard</h1>
<h2>Equipment</h2>
<% if (!items.length) { %><p>No equipment has been added yet.</p><% } else { %>
<table><thead><tr><th>Name</th><th>Description</th><th>Status</th></tr></thead><tbody>
<% items.forEach(i => { %><tr><td><%= i.name %></td><td><%= i.description %></td><td><%= i.status %></td></tr><% }) %>
</tbody></table><% } %>
</body></html>
