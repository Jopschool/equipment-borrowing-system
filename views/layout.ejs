<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? locals.title + ' | ' : '' %>Equipment Borrowing System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

  <nav class="navbar navbar-expand-md site-nav" data-bs-theme="dark">
    <div class="container">
      <a class="navbar-brand brand" href="/">
        <span class="brand-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
        <span>Equipment Borrowing</span>
      </a>

      <% if (locals.user) { %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav me-auto mt-3 mt-md-0">
            <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="fa-solid fa-gauge-high"></i>Dashboard</a></li>
            <% if (user.role === 'admin' || user.role === 'custodian') { %>
              <li class="nav-item"><a class="nav-link" href="/inventory"><i class="fa-solid fa-boxes-stacked"></i>Inventory</a></li>
              <li class="nav-item"><a class="nav-link" href="/admin/requests"><i class="fa-solid fa-clipboard-check"></i>Requests</a></li>
              <li class="nav-item"><a class="nav-link" href="/history"><i class="fa-solid fa-clock-rotate-left"></i>History</a></li>
            <% } %>
          </ul>

          <div class="dropdown mt-3 mt-md-0">
            <button class="user-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="avatar"><%= String(user.name || user.username || '?').charAt(0).toUpperCase() %></span>
              <span><%= user.name || user.username %></span>
              <% if (user.role) { %><span class="role-chip"><%= user.role %></span><% } %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><h6 class="dropdown-header">Signed in as <%= user.name || user.username %></h6></li>
              <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-gauge-high"></i>Dashboard</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="post" action="/logout">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                  <button class="dropdown-item text-danger" type="submit"><i class="fa-solid fa-right-from-bracket"></i>Log out</button>
                </form>
              </li>
            </ul>
          </div>
        </div>
      <% } %>
    </div>
  </nav>

  <main class="container app-main">
    <% if (locals.error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if (locals.success) { %><div class="alert alert-success" role="alert"><%= success %></div><% } %>
    <%- include(contentView) %>
  </main>

  <footer class="site-footer">
    <div class="container">&copy; <%= new Date().getFullYear() %> Equipment Borrowing System</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.querySelectorAll('.site-nav .nav-link').forEach(function (a) {
      if (a.pathname === location.pathname) { a.classList.add('active'); a.setAttribute('aria-current', 'page'); }
    });
  </script>
</body>
</html>